{
  "version": 5,
  "default_account": "",
  "accounts": [],
  "paths": {
    "db": "~/.hermes/plugin-data/hermes-email-watchdog/email.db",
    "seen": "~/.hermes/plugin-data/hermes-email-watchdog/seen.json",
    "cache_dir": "~/.hermes/plugin-data/hermes-email-watchdog/email_cache",
    "threads": "~/.hermes/plugin-data/hermes-email-watchdog/email_threads.json",
    "contacts": "~/.hermes/plugin-data/hermes-email-watchdog/email_contacts.json",
    "attachment_dir": "~/.hermes/plugin-data/hermes-email-watchdog/attachments"
  },
  "watchdog": {
    "lookback": 5,
    "sleep_start": 0,
    "sleep_end": 6,
    "max_cached": 200,
    "seen_max_entries": 5000
  },
  "llm": {
    "enabled": false,
    "endpoint": "",
    "api_key_env": "",
    "model": "",
    "temperature": 0.1,
    "max_tokens": 2000,
    "timeout_seconds": 90,
    "max_body_chars": 12000
  },
  "semantic_engine": {
    "enabled": true,
    "mode": "shadow",
    "provider": "hermes_openai",
    "provider_name": "USTC",
    "endpoint": "",
    "api_key_env": "",
    "model": "deepseek-flash",
    "fallback_model": "qwen3.6-chat",
    "timeout_seconds": 120,
    "temperature": 0.0,
    "max_body_chars": 16000,
    "max_parallel": 1,
    "cache_by_message_hash": true,
    "protocol": "readable_grounded_core_v1v",
    "num_thread": 5,
    "num_predict_mode": "adaptive",
    "num_predict": 1800,
    "num_predict_simple": 700,
    "num_predict_standard": 1200,
    "num_predict_complex": 1800,
    "num_predict_hard_cap": 2048
  },
  "notification": {
    "renderer": "intelligent_v2",
    "mode": "production",
    "production_route_enabled": true,
    "all_mail_push": false,
    "legacy_fallback_enabled": true,
    "fast_lane_enabled": false,
    "original_policy": "auto",
    "original_max_chars": 900,
    "show_priority": true,
    "show_category": true,
    "show_time": true,
    "show_debug_reason": false,
    "suppress_redundant_summary": true
  },
  "semantic_memory": {
    "enabled": true,
    "mode": "shadow",
    "max_examples": 5,
    "max_evidence_keys": 200,
    "learn_from_user_feedback_only": true,
    "runtime_activation": false
  },
  "delivery": {
    "auto_download_attachments": true,
    "forward_attachments_to_weixin": true,
    "auto_forward_safe_attachments": true,
    "attachment_max_bytes": 26214400,
    "attachment_safe_extensions": [
      ".pdf", ".png", ".jpg", ".jpeg", ".gif", ".webp",
      ".txt", ".csv", ".doc", ".docx", ".xls", ".xlsx",
      ".ppt", ".pptx", ".zip", ".7z"
    ],
    "create_reminders": true,
    "managed_cron": true,
    "reminder_offsets_minutes": [1440, 60],
    "calendar_path": "~/.hermes/plugin-data/hermes-email-watchdog/calendar/email-watchdog.ics",
    "timezone": "auto",
    "target": {
      "platform": "",
      "chat_id": "",
      "thread_id": "",
      "chat_type": ""
    }
  },
  "safety": {
    "mailbox_read_only": true,
    "outbound_email_enabled": false,
    "mailbox_mutation_enabled": false
  }
}
